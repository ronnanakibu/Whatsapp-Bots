# ==============================================================================
# RonnBot Control Center — Environment Variables Template
# ==============================================================================
# Copy this file to `.env` and replace all placeholder values before running.
# NEVER commit a real `.env` file or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Networking
# ------------------------------------------------------------------------------
NODE_ENV=production
# Canonical HTTP + Socket.IO port (default: 25637)
PORT=25637
# Host port published by docker-compose.yml
HOST_PORT=25637
# Bind interface inside container (use 0.0.0.0 for Docker)
RADIO_LISTEN_HOST=0.0.0.0
# Optional public hostname/base URL overrides for generated dashboard links
RADIO_HOST=localhost
# DASHBOARD_URL=https://control.example.com/dashboard
# Comma-separated exact origin allowlist required in production (no trailing slashes, no wildcards)
# Example for Vercel frontend: ALLOWED_ORIGINS=https://control.example.com
ALLOWED_ORIGINS=http://localhost:25637
# Set when running behind a trusted TLS reverse proxy (e.g., 1 hop for Caddy/Nginx)
# TRUST_PROXY=1
BOT_TIMEZONE=Asia/Jakarta

# ------------------------------------------------------------------------------
# 2. Control Center & Radio Authentication (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Independent 256-bit random signing secrets (>= 32 chars; production fails closed if missing, placeholder, weak or identical)
# Generate via: openssl rand -hex 32
CONTROL_JWT_SECRET=
RADIO_JWT_SECRET=
# Optional unified legacy fallback (strictly disabled in production)
JWT_SECRET=
# Optional bootstrap Control Center owner account (created once if DB has no owner)
CONTROL_OWNER_USERNAME=owner
CONTROL_OWNER_PASSWORD=
# Optional bridge API key if bridge integrations are enabled
BRIDGE_API_KEY=

# ------------------------------------------------------------------------------
# 3. Databases (SQLite + PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# SQLite operational store (keep inside /app/storage/database volume)
DB_PATH=./storage/database/main.db

# PostgreSQL connection (used by Prisma for Radio community models)
POSTGRES_USER=ronnbot
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=ronnbot_radio
# Inside Docker Compose, host is `postgres` on the internal network:
DATABASE_URL=postgresql://ronnbot:replace_with_strong_postgres_password@postgres:5432/ronnbot_radio?schema=public
# Set to "true" only when running schema push intentionally on boot
PRISMA_AUTO_MIGRATE=false

# ------------------------------------------------------------------------------
# 4. WhatsApp Bot Identity & Pairing
# ------------------------------------------------------------------------------
# Required by start.js preflight
BOT_PREFIX=!
# Owner WhatsApp number (international format without +, e.g., 6280000000000)
OWNER_NUMBER=6280000000000
AUTO_READ=true
# Optional pairing phone number if using code-based WhatsApp pairing
PAIRING_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 5. AI Providers (Optional — omit keys for unused providers)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
HF_TOKEN=

# Hermes Agent (optional local/remote agent endpoint)
HERMES_AGENT_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_ENABLED=false

# ------------------------------------------------------------------------------
# 6. Radio, Media & Integrations (Optional)
# ------------------------------------------------------------------------------
RADIO_MAX_QUEUE=20
# RADIO_STATUS_URL=
# RADIO_STREAM_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
DISCORD_TOKEN=
DISCORD_OWNER_ID=
CEF_WEB_URL=
CEF_API_KEY=
CEF_STORY_TARGET_ACCOUNT=
CEF_STORY_INTERVAL_MINUTES=10
CEF_STORY_NOTIFY_JID=

# ------------------------------------------------------------------------------
# 7. Legacy / Pterodactyl Fallback (Secondary Deployment Only)
# ------------------------------------------------------------------------------
# Deprecated alias for PORT; retained only for legacy Pterodactyl startup panels
# RADIO_PORT=25637
# SFTP_* variables are only used by legacy deploy.js
# SFTP_HOST=
# SFTP_PORT=2022
# SFTP_USERNAME=
# SFTP_PASSWORD=
